#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_000001C982A02A90 .scope module, "tb_argmax" "tb_argmax" 2 3;
 .timescale -9 -12;
v000001C982A6AD50_0 .var/i "i", 31 0;
v000001C982A6A0D0_0 .var "in_bus", 159 0;
v000001C982A6AA30 .array "logits", 9 0, 15 0;
v000001C982A6A8F0_0 .net "out_digit", 3 0, v000001C982A6A490_0;  1 drivers
S_000001C982A046B0 .scope module, "u_argmax" "argmax" 2 10, 3 3 0, S_000001C982A02A90;
 .timescale -9 -12;
    .port_info 0 /INPUT 160 "in_bus";
    .port_info 1 /OUTPUT 4 "out_digit";
v000001C982A04070_0 .var/s "current_val", 15 0;
v000001C9829DE650_0 .var/i "i", 31 0;
v000001C982A04840_0 .net "in_bus", 159 0, v000001C982A6A0D0_0;  1 drivers
v000001C982A6A350_0 .var/s "max_val", 15 0;
v000001C982A6A490_0 .var "out_digit", 3 0;
E_000001C982A06430 .event anyedge, v000001C982A04840_0, v000001C982A04070_0, v000001C982A6A350_0;
    .scope S_000001C982A046B0;
T_0 ;
    %wait E_000001C982A06430;
    %load/vec4 v000001C982A04840_0;
    %parti/s 16, 0, 2;
    %store/vec4 v000001C982A6A350_0, 0, 16;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001C982A6A490_0, 0, 4;
    %pushi/vec4 1, 0, 32;
    %store/vec4 v000001C9829DE650_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v000001C9829DE650_0;
    %cmpi/s 10, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %load/vec4 v000001C982A04840_0;
    %load/vec4 v000001C9829DE650_0;
    %muli 16, 0, 32;
    %part/s 16;
    %store/vec4 v000001C982A04070_0, 0, 16;
    %load/vec4 v000001C982A6A350_0;
    %load/vec4 v000001C982A04070_0;
    %cmp/s;
    %jmp/0xz  T_0.3, 5;
    %load/vec4 v000001C982A04070_0;
    %store/vec4 v000001C982A6A350_0, 0, 16;
    %load/vec4 v000001C9829DE650_0;
    %parti/s 4, 0, 2;
    %store/vec4 v000001C982A6A490_0, 0, 4;
T_0.3 ;
T_0.2 ; for-loop step statement
    %load/vec4 v000001C9829DE650_0;
    %addi 1, 0, 32;
    %store/vec4 v000001C9829DE650_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001C982A02A90;
T_1 ;
    %vpi_call 2 16 "$dumpfile", "tb_argmax.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001C982A02A90 {0 0 0};
    %vpi_call 2 20 "$readmemh", "layer3_expected_outs.hex", v000001C982A6AA30 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001C982A6AD50_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v000001C982A6AD50_0;
    %cmpi/s 10, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %ix/getv/s 4, v000001C982A6AD50_0;
    %load/vec4a v000001C982A6AA30, 4;
    %load/vec4 v000001C982A6AD50_0;
    %muli 16, 0, 32;
    %ix/vec4/s 4;
    %store/vec4 v000001C982A6A0D0_0, 4, 16;
T_1.2 ; for-loop step statement
    %load/vec4 v000001C982A6AD50_0;
    %addi 1, 0, 32;
    %store/vec4 v000001C982A6AD50_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %delay 10000, 0;
    %vpi_call 2 29 "$display", "----------------------------------------" {0 0 0};
    %vpi_call 2 30 "$display", "Argmax Test Results:" {0 0 0};
    %vpi_call 2 31 "$display", "----------------------------------------" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001C982A6AD50_0, 0, 32;
T_1.3 ; Top of for-loop
    %load/vec4 v000001C982A6AD50_0;
    %cmpi/s 10, 0, 32;
	  %jmp/0xz T_1.4, 5;
    %vpi_call 2 33 "$display", "Digit %0d logit: %h", v000001C982A6AD50_0, &A<v000001C982A6AA30, v000001C982A6AD50_0 > {0 0 0};
T_1.5 ; for-loop step statement
    %load/vec4 v000001C982A6AD50_0;
    %addi 1, 0, 32;
    %store/vec4 v000001C982A6AD50_0, 0, 32;
    %jmp T_1.3;
T_1.4 ; for-loop exit label
    %vpi_call 2 35 "$display", "----------------------------------------" {0 0 0};
    %load/vec4 v000001C982A6A8F0_0;
    %cmpi/e 1, 0, 4;
    %jmp/0xz  T_1.6, 6;
    %vpi_call 2 42 "$display", "PASS: Argmax correctly selected digit %0d!", v000001C982A6A8F0_0 {0 0 0};
    %jmp T_1.7;
T_1.6 ;
    %vpi_call 2 44 "$display", "FAIL: Argmax selected digit %0d, expected 1", v000001C982A6A8F0_0 {0 0 0};
T_1.7 ;
    %vpi_call 2 46 "$display", "----------------------------------------" {0 0 0};
    %vpi_call 2 47 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_argmax.v";
